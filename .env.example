# Copy to .env and fill in what you have. Everything works WITHOUT keys (static mode).
# The first provider with a key is primary; a second one becomes the automatic fallback.

# --- Nebius Token Factory (course default, OpenAI compatible) ---
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Fireworks (OpenAI compatible) ---
FIREWORKS_API_KEY=
# FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Force a provider, or "static" to disable LLM calls
# CS_PROVIDER=nebius

# --- Integrations ---
# Lets the human approved "post comment" action post to GitHub PRs
GITHUB_TOKEN=
# Mirrors team conventions and review history to the Mem0 platform
MEM0_API_KEY=

# --- Optional LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=codesentinel

# --- Tuning ---
# CS_LLM_TIMEOUT=60
# CS_LLM_RETRIES=2
# CS_AGENT_STEP_LIMIT=12
# CS_MAX_FILES=15
# CS_LLM_CACHE_TTL=86400
# CS_GITHUB_CACHE_TTL=300
# CS_SLOW_AGENT_SECONDS=45
